# Copie ce fichier en .env (cp .env.example .env), remplis-le, puis: chmod 600 .env
# Ce sont les mêmes valeurs que les secrets GitHub. Ne le versionne jamais.

# --- Flux et créneau (record.yml) ---
STREAM_URL=
RECORD_START=          # ex. 18:00
RECORD_END=            # ex. 23:30 (une fin avant le début = lendemain)
RECORD_DAYS=           # optionnel, 1=lundi ... 7=dimanche, ex. 1,2,3,4,5
RECORD_TZ=               # Region/City (défaut: UTC)
DRIVE_FOLDER=Recordings
PODCAST_TITLE=Recordings

# --- Google Drive ---
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# --- Rapport par e-mail (optionnel) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_TO=

# --- Notifications ntfy (optionnel) ---
NTFY_TOPIC=
SHOW_END_TOPIC=

# --- Page de l'émission et Notion (optionnel) ---
SHOW_PAGE_URL=
NOTION_TOKEN=
NOTION_HISTORY_DB=

# --- Résumés (summary.yml, lancés par summary.sh) ---
ANTHROPIC_API_KEY=
TRANSCRIPT_LANGUAGE=
SUMMARY_INSTRUCTIONS=
